# ---------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá las claves que vayas a usar.
# Alcanza con una de las dos para que `python main.py` corra.
# ---------------------------------------------------------------------------

# Proveedor por defecto: openai | anthropic | gemini
LLM_PROVIDER=openai

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional: cualquier endpoint compatible con la API de OpenAI.
# Ej. Groq (tier gratuito): https://api.groq.com/openai/v1  +  OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=

# Anthropic -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=
# Profundidad del razonamiento: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low

# Gemini -> https://aistudio.google.com/apikey  (tier gratuito)
# Se consume por su capa compatible con la API de OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=
# Razonamiento: none | low | medium | high. Los modelos Gemini 3 razonan
# antes de responder y esos tokens salen de LLM_MAX_TOKENS: con `none` la
# respuesta entra en un presupuesto chico.
GEMINI_EFFORT=none

# --- Parámetros de generación (validados por Pydantic) ---------------------
LLM_TEMPERATURE=0.7   # 0 a 2 (Anthropic acepta sólo hasta 1)
LLM_MAX_TOKENS=2048   # > 0; en modelos de razonamiento incluye el thinking
LLM_TIMEOUT_S=30      # timeout por intento
LLM_MAX_RETRIES=2     # reintentos ante 429 / 5xx / red
