# ---------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá las claves que vayas a usar.
# Alcanza con una de las dos para que `python main.py` corra.
# ---------------------------------------------------------------------------

# Proveedor por defecto: openai | anthropic
LLM_PROVIDER=openai

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional: cualquier endpoint compatible con la API de OpenAI.
# Ej. Groq (tier gratuito): https://api.groq.com/openai/v1  +  OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=

# Anthropic -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=
# Profundidad del razonamiento: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low

# --- Parámetros de generación (validados por Pydantic) ---------------------
LLM_TEMPERATURE=0.7   # 0 a 2 (Anthropic acepta sólo hasta 1)
LLM_MAX_TOKENS=1024   # > 0
LLM_TIMEOUT_S=30      # timeout por intento
LLM_MAX_RETRIES=2     # reintentos ante 429 / 5xx / red
