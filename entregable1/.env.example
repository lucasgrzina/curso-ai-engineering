# ---------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá tus claves.
# Sin claves el proyecto igual corre: los proveedores caen en modo simulado.
# ---------------------------------------------------------------------------

# Google AI Studio (tier gratuito) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq Cloud (tier gratuito) -> https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Parámetros del ejercicio -------------------------------------------
TOTAL_TIMEOUT_S=2.0        # timeout exigido por la consigna
SEMAPHORE_LIMIT=2          # cuántas llamadas pueden correr a la vez
BURST_SIZE=10              # cuántas llamadas se disparan en el escenario B
LOCAL_LLAMA_LATENCY_S=3.0  # latencia del modelo local: excede el timeout aposta
