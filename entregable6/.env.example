# ---------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá la clave del proveedor que uses.
# Alcanza con UNA de las tres para que `python main.py` corra.
# ---------------------------------------------------------------------------

# Proveedor por defecto: openai | anthropic | gemini
LLM_PROVIDER=gemini

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional: cualquier endpoint compatible con la API de OpenAI.
# Ej. Groq (tier gratuito): https://api.groq.com/openai/v1  +  OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=

# Anthropic -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini -> https://aistudio.google.com/apikey  (tier gratuito)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Opcionales del orquestador
# ORQ_MAX_PASOS=8             # techo de invocaciones a especialistas (anti "supervisor infinito")
# ORQ_MAX_REFINAMIENTOS=1     # cuántas veces se le puede pedir a un mismo especialista que refine
