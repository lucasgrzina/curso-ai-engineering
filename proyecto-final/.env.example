# ---------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá la clave del proveedor que uses.
# Alcanza con UNA de las tres para que el sistema corra. NUNCA subas el .env.
# ---------------------------------------------------------------------------

# Proveedor por defecto: openai | anthropic | gemini
LLM_PROVIDER=gemini

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional: cualquier endpoint compatible con la API de OpenAI.
# Ej. Groq (tier gratuito): https://api.groq.com/openai/v1  +  OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=

# Anthropic -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini -> https://aistudio.google.com/apikey  (tier gratuito)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Reintentos con backoff ante 429 (rate limit) del proveedor bajo carga.
LLM_MAX_RETRIES=6

# ---------------------------------------------------------------------------
# Redis (estado de jobs + checkpoints de LangGraph). Requiere Redis STACK
# (trae RediSearch, que usa el RedisSaver). Con docker compose: redis://redis:6379/0
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# JOB_TTL=86400              # segundos que vive cada job en Redis (default 24 h)

# ---------------------------------------------------------------------------
# RAG (base de conocimiento vectorial, Módulos 3 y 4). Todo tiene default;
# descomentá solo si querés cambiarlo. Sin hard-coding en el código.
# ---------------------------------------------------------------------------
# CHROMA_PERSIST_DIR=./vectorstore
# CHROMA_COLLECTION=techcorp_politicas
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_TOP_K=4

# ---------------------------------------------------------------------------
# Observabilidad: phoenix | langsmith | none
# ---------------------------------------------------------------------------
OBSERVABILITY=phoenix
PHOENIX_PROJECT_NAME=intelligence-system
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Si usás LangSmith en vez de Phoenix (OBSERVABILITY=langsmith):
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=intelligence-system
