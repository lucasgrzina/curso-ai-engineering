# ---------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá la clave del proveedor que uses.
# Alcanza con UNA de las tres para que la API corra.
# ---------------------------------------------------------------------------

# Proveedor por defecto: openai | anthropic | gemini
LLM_PROVIDER=gemini

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional: cualquier endpoint compatible con la API de OpenAI.
# Ej. Groq (tier gratuito): https://api.groq.com/openai/v1  +  OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=

# Anthropic -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini -> https://aistudio.google.com/apikey  (tier gratuito)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Redis (estado de jobs + checkpoints de LangGraph). Requiere Redis STACK
# (trae RediSearch, que usa el RedisSaver). Con docker compose: redis://redis:6379/0
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# JOB_TTL=86400              # segundos que vive cada job en Redis (default 24 h)

# ---------------------------------------------------------------------------
# Observabilidad: phoenix | langsmith | none
# ---------------------------------------------------------------------------
OBSERVABILITY=phoenix
PHOENIX_PROJECT_NAME=entregable7-orquestador
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Si usás LangSmith en vez de Phoenix (OBSERVABILITY=langsmith):
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=entregable7-orquestador

# ---------------------------------------------------------------------------
# Costo en USD por ejecución (app/costos.py). Por defecto usa una tabla de
# precios por modelo. Si tu proveedor publica otra tarifa, forzá el precio de
# CUALQUIER modelo con estas dos (USD por 1.000.000 de tokens):
# ---------------------------------------------------------------------------
# COSTO_USD_INPUT_POR_1M=0.10
# COSTO_USD_OUTPUT_POR_1M=0.50

# Opcionales del orquestador (M6)
# ORQ_MAX_PASOS=8             # techo de invocaciones a especialistas (anti "supervisor infinito")
# ORQ_MAX_REFINAMIENTOS=1     # cuántas veces se le puede pedir a un mismo especialista que refine
