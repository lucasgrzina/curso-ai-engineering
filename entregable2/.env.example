# ---------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá las claves que vayas a usar.
# Alcanza con una de las tres para que `python main.py` corra.
# ---------------------------------------------------------------------------

# Proveedor por defecto: openai | anthropic | gemini
LLM_PROVIDER=gemini

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional: cualquier endpoint compatible con la API de OpenAI.
# Ej. Groq (tier gratuito): https://api.groq.com/openai/v1  +  OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=

# Anthropic -> https://console.anthropic.com/settings/keys
# Ajustá el ID al modelo que tengas habilitado en tu cuenta (ver la doc de modelos).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini -> https://aistudio.google.com/apikey  (tier gratuito)
# Ajustá el ID al modelo disponible en tu API key (ver AI Studio).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cantidad máxima de intentos de la cadena ante un JSON mal formado o
# incompleto (usado por `.with_retry(stop_after_attempt=...)`).
LLM_MAX_RETRIES=3
