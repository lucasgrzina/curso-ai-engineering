# ---------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá la clave del proveedor que uses
# para la GENERACIÓN. Los embeddings son locales (HuggingFace) y NO necesitan
# ninguna API key.
# ---------------------------------------------------------------------------

# Proveedor de generación por defecto: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Gemini -> https://aistudio.google.com/apikey  (tier gratuito, recomendado)
# Se acepta GEMINI_API_KEY o GOOGLE_API_KEY (cualquiera de las dos).
GEMINI_API_KEY=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional: endpoint compatible con la API de OpenAI (ej. Groq).
OPENAI_BASE_URL=

# Anthropic -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Reintentos de la cadena LCEL ante un output mal formado.
LLM_MAX_RETRIES=3

# Opcionales: ubicación/colección del índice y cantidad de fragmentos (top_k).
# CHROMA_PERSIST_DIR=./vectorstore
# CHROMA_COLLECTION=autorenta_policies
# RAG_TOP_K=4
