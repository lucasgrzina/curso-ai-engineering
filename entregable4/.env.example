# ---------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá tu clave de Pinecone.
# Por defecto los embeddings son locales (HuggingFace) y OPENAI_API_KEY puede
# quedar vacía. Si querés embeddings de OpenAI, poné EMBEDDINGS_PROVIDER=openai
# y completá OPENAI_API_KEY (usa otro INDEX_NAME: la dimensión pasa de 384 a 1536).
# ---------------------------------------------------------------------------

# Pinecone -> https://app.pinecone.io  (plan gratuito, alcanza de sobra)
PINECONE_API_KEY=

# OpenAI -> https://platform.openai.com/api-keys (solo si EMBEDDINGS_PROVIDER=openai)
OPENAI_API_KEY=

# Nombre del índice Serverless. Se crea solo si no existe (`python setup_index.py`).
INDEX_NAME=nimbus-rag-hibrido

# Opcionales
# EMBEDDINGS_PROVIDER=huggingface   # huggingface (local, 384 dim) | openai (1536 dim)
# PINECONE_NAMESPACE=nimbus-docs
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# RAG_TOP_K=5
