# ---------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá tu clave de Pinecone.
# Los embeddings son locales (HuggingFace) y NO necesitan ninguna API key de
# OpenAI/Anthropic: este módulo solo recupera, no genera texto con un LLM.
# ---------------------------------------------------------------------------

# Pinecone -> https://app.pinecone.io  (plan gratuito, alcanza de sobra)
PINECONE_API_KEY=

# Nombre del índice Serverless. Se crea solo si no existe (`python setup_index.py`).
INDEX_NAME=nimbus-rag-hibrido

# Opcionales
# PINECONE_NAMESPACE=nimbus-docs
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# RAG_TOP_K=5
